#!/bin/sh

# PROVIDE: seerr
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# seerr_enable (bool):	Set to NO by default.
#			Set it to YES to enable seerr.
# seerr_user (str):	User to run seerr as.  Default: seerr
# seerr_group (str):	Group to run seerr as.  Default: seerr
# seerr_datadir (str):	Configuration and database directory.
#			Default: /var/db/seerr
# seerr_port (int):	TCP port to listen on.  Default: 5055
# seerr_env (str):	Extra environment, such as the DB_* variables
#			that select PostgreSQL.  Default: empty

. /etc/rc.subr

name=seerr
rcvar=seerr_enable

load_rc_config $name

: ${seerr_enable:="NO"}
: ${seerr_user:="seerr"}
: ${seerr_group:="seerr"}
: ${seerr_datadir:="/var/db/seerr"}
: ${seerr_port:="5055"}

pidfile="/var/run/${name}/${name}.pid"
procname="%%LOCALBASE%%/bin/node"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -t ${name} ${procname} %%WWWDIR%%/dist/index.js"
# next serves the application from the current directory
seerr_chdir="%%WWWDIR%%"
seerr_env="NODE_ENV=production CONFIG_DIRECTORY=${seerr_datadir} \
    PORT=${seerr_port} HOME=${seerr_datadir} ${seerr_env}"

start_precmd="${name}_precmd"

seerr_precmd()
{
	install -d -o "${seerr_user}" -g "${seerr_group}" -m 750 \
	    "/var/run/${name}" "${seerr_datadir}"
}

run_rc_command "$1"
