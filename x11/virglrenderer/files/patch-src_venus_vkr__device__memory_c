+/*
+ * VK_EXT_external_memory_host backing for host-visible VkDeviceMemory.  Used on
+ * FreeBSD, where the VMM cannot mmap a dma_buf fd (drm-kmod dma_buf_mmap_fileops
+ * is a no-op) but can mmap an shm fd.  Allocate shm, import it as VkDeviceMemory
+ * via VkImportMemoryHostPointerInfoEXT, and export the shm fd (FD_SHM) so the
+ * VMM can map it -- the same shm-backed pattern as the Metal path.
+ */
+struct vkr_host_shm {
+   int shm_fd;
+   void *ptr;
+   uint64_t size;
+};
+
 static void
+vkr_host_shm_free(struct vkr_host_shm *shm)
+{
+   if (!shm)
+      return;
+   if (shm->ptr && shm->ptr != MAP_FAILED)
+      munmap(shm->ptr, shm->size);
+   if (shm->shm_fd >= 0)
+      close(shm->shm_fd);
+   free(shm);
+}
+
+#ifdef __FreeBSD__
+static struct vkr_host_shm *
+vkr_host_shm_alloc(uint64_t size, uint64_t alignment)
+{
+   const uint64_t align = alignment ? alignment : 4096;
+   const uint64_t aligned = (size + align - 1) & ~(align - 1);
+
+   int fd = os_create_anonymous_file(aligned, "vkr-host-mem");
+   if (fd < 0)
+      return NULL;
+
+   void *ptr = mmap(NULL, aligned, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+   if (ptr == MAP_FAILED) {
+      close(fd);
+      return NULL;
+   }
+
+   struct vkr_host_shm *shm = calloc(1, sizeof(*shm));
+   if (!shm) {
+      munmap(ptr, aligned);
+      close(fd);
+      return NULL;
+   }
+   shm->shm_fd = fd;
+   shm->ptr = ptr;
+   shm->size = aligned;
+   return shm;
+}
+#endif /* __FreeBSD__ */
